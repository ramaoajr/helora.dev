# Variáveis de ambiente do servidor (Cloudflare Pages Functions).
# Copie para `.env` localmente e configure os mesmos valores no painel da Cloudflare
# (Workers e Pages > helora-dev > Settings > Variables and Secrets), como Secret,
# nos ambientes Production e Preview.
#
# ATENÇÃO: estes valores são SEGREDOS. Nunca faça commit dos valores reais —
# `.env` já está no .gitignore. Eles são lidos apenas por `functions/api/contact.js`,
# no servidor, e nunca chegam ao bundle do navegador.

# URL do webhook do cenário Make.com que recebe os leads do formulário de contato.
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id-here

# Chave de API enviada no header `x-make-apikey` para o webhook acima.
MAKE_API_KEY=your-make-api-key-here
